{
  "schema": "nai-axioms-v1",
  "operators": [
    "relational_graph",
    "arithmetic",
    "linear_equation",
    "parallel_completion",
    "age_difference",
    "rank_overtake",
    "co_moving_reference",
    "indivisible_process",
    "unitary_concept"
  ],
  "rules": [
    {
      "id": "strict-height-transitivity",
      "body": [
        [
          "?a",
          "taller",
          "?b"
        ],
        [
          "?b",
          "taller",
          "?c"
        ]
      ],
      "head": [
        "?a",
        "taller",
        "?c"
      ]
    },
    {
      "id": "class-inheritance",
      "body": [
        [
          "?a",
          "isa",
          "?b"
        ],
        [
          "?b",
          "subclass",
          "?c"
        ]
      ],
      "head": [
        "?a",
        "isa",
        "?c"
      ]
    },
    {
      "id": "universal-action",
      "body": [
        [
          "?a",
          "isa",
          "?b"
        ],
        [
          "?b",
          "all_action",
          "?v"
        ]
      ],
      "head": [
        "?a",
        "action",
        "?v"
      ]
    },
    {
      "id": "concept-classification-with-executed-event",
      "version": 1,
      "body": [
        [
          "?event",
          "instance_of",
          "?concept"
        ],
        [
          "?event",
          "event_status",
          "executed"
        ]
      ],
      "head": [
        "?event",
        "classified_by",
        "?concept"
      ]
    },
    {
      "id": "learned-transfer-permission-relation",
      "version": 1,
      "body": [
        ["?event", "instance_of", "?concept"],
        ["?concept", "concept_effect", "count_add"],
        ["?event", "event_role", "?role"],
        ["?role", "role_name", "taker"],
        ["?role", "role_value", "?person"],
        ["?person", "transfer_permission", "approved"]
      ],
      "head": ["?event", "learned_relation", "transfer_allowed"]
    },
    {
      "id": "learned-placement-permission-relation",
      "version": 1,
      "body": [
        ["?event", "instance_of", "?concept"],
        ["?concept", "concept_effect", "location"],
        ["?event", "event_role", "?role"],
        ["?role", "role_name", "item"],
        ["?role", "role_value", "?item"],
        ["?item", "placement_permission", "approved"]
      ],
      "head": ["?event", "learned_relation", "placement_allowed"]
    }
  ],
  "mutable_predicates": [
    "location",
    "count",
    "relation_status"
  ],
  "numeric_updates": {
    "count_add": {
      "target": "count",
      "factor": 1
    },
    "count_remove": {
      "target": "count",
      "factor": -1
    }
  },
  "comparisons": {
    "count_greater": {
      "target": "count",
      "op": ">"
    },
    "count_smaller": {
      "target": "count",
      "op": "<"
    }
  }
}
