{
 "schema": "marco1-reasoning-gate-v1",
 "id": "en-count-04",
 "language": "en",
 "kind": "count_arithmetic",
 "setup": [
  {
   "n": 1,
   "say": "Cyrus has 8 tokens.",
   "events": [
    {
     "type": "has",
     "holder": "Cyrus",
     "item": "tokens",
     "quantity": 8
    }
   ]
  },
  {
   "n": 2,
   "say": "Dina has 11 tokens.",
   "events": [
    {
     "type": "has",
     "holder": "Dina",
     "item": "tokens",
     "quantity": 11
    }
   ]
  },
  {
   "n": 3,
   "say": "Cyrus got 9 tokens.",
   "events": [
    {
     "type": "add",
     "holder": "Cyrus",
     "item": "tokens",
     "quantity": 9
    }
   ]
  },
  {
   "n": 4,
   "say": "Dina lost 4 tokens.",
   "events": [
    {
     "type": "use",
     "holder": "Dina",
     "item": "tokens",
     "quantity": 4
    }
   ]
  }
 ],
 "questions": [
  {
   "q": 1,
   "after": 4,
   "say": "How many tokens does Cyrus have now?",
   "expect": {
    "type": "count",
    "entity": "Cyrus",
    "item": "tokens",
    "value": 17
   },
   "derivation": {
    "facts": [
     1,
     3
    ],
    "rules": [
     "count_update"
    ],
    "steps": [
     "Cyrus tokens: 8 [1] +9 [3] = 17"
    ]
   }
  },
  {
   "q": 2,
   "after": 4,
   "say": "How many tokens does Dina have now?",
   "expect": {
    "type": "count",
    "entity": "Dina",
    "item": "tokens",
    "value": 7
   },
   "derivation": {
    "facts": [
     2,
     4
    ],
    "rules": [
     "count_update"
    ],
    "steps": [
     "Dina tokens: 11 [2] -4 [4] = 7"
    ]
   }
  }
 ]
}
