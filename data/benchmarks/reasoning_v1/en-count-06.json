{
 "schema": "marco1-reasoning-gate-v1",
 "id": "en-count-06",
 "language": "en",
 "kind": "count_arithmetic",
 "setup": [
  {
   "n": 1,
   "say": "Fenna has 6 badges.",
   "events": [
    {
     "type": "has",
     "holder": "Fenna",
     "item": "badges",
     "quantity": 6
    }
   ]
  },
  {
