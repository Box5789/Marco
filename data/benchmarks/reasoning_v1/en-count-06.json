     "holder": "Fenna",
     "item": "badges",
     "quantity": 7
    }
   ]
  },
  {
   "n": 3,
   "say": "Fenna lost 3 badges.",
   "events": [
    {
     "type": "use",
     "holder": "Fenna",
     "item": "badges",
     "quantity": 3
    }
   ]
  }
 ],
 "questions": [
  {
   "q": 1,
   "after": 1,
   "say": "How many badges does Fenna have?",
   "expect": {
