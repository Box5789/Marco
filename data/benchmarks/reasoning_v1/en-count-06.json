   "expect": {
    "type": "count",
    "entity": "Fenna",
    "item": "badges",
    "value": 10
   },
   "derivation": {
    "facts": [
     1,
     2,
     3
    ],
    "rules": [
     "count_update"
    ],
    "steps": [
