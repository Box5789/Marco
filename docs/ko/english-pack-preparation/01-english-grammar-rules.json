  "morphology": {
    "id": "morph/en-v1",
    "_설명": "알려진 표제어에서만 굴절을 만든다. 모르는 낱말을 규칙 활용이라고 추정하지 않는다. 한국어 팩 '활용' 과 같은 원칙이되 조작은 전혀 다르다.",
    "noun_plural": {
      "default": {"op": "append", "text": "s"},
      "conditions": [
        {"when_final": ["s", "x", "z", "ch", "sh"], "op": "append", "text": "es"},
        {"when_final": ["y"], "when_prev_not_vowel": true, "op": "replace_final", "from": "y", "to": "ies"},
        {"when_final": ["f"], "op": "replace_final", "from": "f", "to": "ves", "optional": true},
        {"when_final": ["fe"], "op": "replace_final", "from": "fe", "to": "ves", "optional": true}
      ],
      "irregular": {"person": "people", "child": "children", "man": "men", "woman": "women", "foot": "feet", "tooth": "teeth", "mouse": "mice", "sheep": "sheep", "fish": "fish", "series": "series"},
      "uncountable": ["money", "water", "rice", "information", "furniture"],
      "_uncountable": "셀 수 없는 명사는 개수 연쇄에 들어갈 수 없다. amount 자리의 명사가 이 목록에 있으면 해석을 보류한다 — 추측해 세지 않는다."
    },
    "article_exceptions": {"an": ["hour", "honest", "honor", "heir"], "a": ["university", "user", "unit", "European", "one"]},
    "verb": {
      "kinds": ["regular", "irregular", "modal", "copula"],
      "max_forms": 6,
      "slots": ["base", "third_sg", "past", "past_participle", "present_participle"],
      "regular": {
        "third_sg": [
          {"when_final": ["s", "x", "z", "ch", "sh", "o"], "op": "append", "text": "es"},
          {"when_final": ["y"], "when_prev_not_vowel": true, "op": "replace_final", "from": "y", "to": "ies"},
          {"op": "append", "text": "s"}
        ],
        "past": [
          {"when_final": ["e"], "op": "append", "text": "d"},
          {"when_final": ["y"], "when_prev_not_vowel": true, "op": "replace_final", "from": "y", "to": "ied"},
          {"when_cvc_stressed": true, "op": "double_final_then_append", "text": "ed"},
          {"op": "append", "text": "ed"}
        ],
        "past_participle": [{"same_as": "past"}],
        "present_participle": [
          {"when_final": ["e"], "when_not": ["ee", "ye", "oe"], "op": "replace_final", "from": "e", "to": "ing"},
          {"when_cvc_stressed": true, "op": "double_final_then_append", "text": "ing"},
          {"op": "append", "text": "ing"}
        ]
      },
      "irregular": {
        "be": {"present_1sg": "am", "present_3sg": "is", "present_other": "are", "past_sg": "was", "past_other": "were", "past_participle": "been", "present_participle": "being"},
        "have": {"third_sg": "has", "past": "had", "past_participle": "had", "present_participle": "having"},
        "do": {"third_sg": "does", "past": "did", "past_participle": "done", "present_participle": "doing"},
        "give": {"past": "gave", "past_participle": "given"},
        "take": {"past": "took", "past_participle": "taken"},
        "put": {"past": "put", "past_participle": "put"},
        "get": {"past": "got", "past_participle": "gotten", "alt_past_participle": "got"},
        "leave": {"past": "left", "past_participle": "left"},
        "hold": {"past": "held", "past_participle": "held"},
        "know": {"past": "knew", "past_participle": "known"},
        "say": {"past": "said", "past_participle": "said"},
        "tell": {"past": "told", "past_participle": "told"},
        "keep": {"past": "kept", "past_participle": "kept"},
        "send": {"past": "sent", "past_participle": "sent"},
        "bring": {"past": "brought", "past_participle": "brought"},
        "buy": {"past": "bought", "past_participle": "bought"},
        "make": {"past": "made", "past_participle": "made"}
      },
      "_irregular": "여기 없는 동사를 불규칙으로 가정하지 않는다. 목록에 없으면 regular 로 생성하되, 생성형이 입력과 안 맞으면 '모르는 활용' 으로 보류한다."
    },
    "adjective_comparative": {
