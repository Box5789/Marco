  "rules": [
    {
      "id": "rule/en-existential-count",
      "for_scenario": "sc/quantity-state",
      "reads": ["there", "be:{tense}", "{amount:numeral}", "{item:noun_pl}"],
      "order": "fixed",
      "optional": [],
      "bind": {"amount": "role/amount", "item": "role/item"},
      "conditions": ["item 이 uncountable 목록에 없을 것", "amount 가 numerals 로 읽힐 것"],
      "emits": {"triples": [[["$item"], "count", "$amount"]], "modality": "actual"},
      "exceptions": [
        "'There are stones.' 처럼 수가 없으면 count 를 만들지 않는다. 존재만 말하고 수량은 미상이다.",
        "'there' 는 허수 주어라 어떤 역할도 받지 않는다. agent 로 배정하면 오답이다."
      ],
      "_grammatical_subject": "문법 주어는 there 이고 수량 보유 대상은 item 이다. 둘을 동일시하지 않는다."
    },
    {
      "id": "rule/en-have-count",
      "for_scenario": "sc/quantity-state",
      "reads": ["{holder:proper_noun}", "have:{tense,person}", "{amount:numeral}", "{item:noun_pl}"],
      "order": "fixed",
      "bind": {"holder": "role/holder", "amount": "role/amount", "item": "role/item"},
      "emits": {"triples": [[["$holder", "$item"], "count", "$amount"]], "modality": "actual"},
      "_": "복합 주체('민수 구슬')에 대응한다. 기존 코드가 [holder, item] 쌍을 subject 로 쓰는 것을 그대로 따른다(relational_semantics.py 주석 확인).",
      "exceptions": ["'have to' 는 의무 조동사다. have 뒤가 to+동사원형이면 이 규칙이 아니다."]
    },
    {
      "id": "rule/en-count-remove",
      "for_scenario": "sc/quantity-state",
      "reads": ["{agent:np}", "take|remove:{past}", "{amount:numeral}", "{item:noun_pl}"],
      "order": "fixed_with_separable_particle",
      "optional": [{"particle": "out", "positions": ["동사 직후", "목적어 직후"]}, {"adposition": "adp/out_of", "binds": "role/source"}],
      "bind": {"agent": "role/agent", "amount": "role/amount", "item": "role/item", "source": "role/source"},
      "conditions": ["modality 가 actual 일 것", "polarity 가 positive 일 것"],
      "emits": {"triples": [[["$item"], "count_remove", "$amount"]], "modality": "actual"},
      "exceptions": [
        "phrasal verb 분리: 'took 8 stones out' 과 'took out 8 stones' 는 같은 뜻이다. 두 어순을 한 규칙이 덮어야 한다. 한국어에는 이 기제 자체가 없다.",
        "'I will take out 8 stones' 는 planned 라 상태를 바꾸지 않는다.",
        "'I didn't take out 8 stones' 는 negative 라 상태를 바꾸지 않는다."
      ]
    },
    {
      "id": "rule/en-count-add",
      "for_scenario": "sc/quantity-state",
      "reads": ["{agent:np}", "put|add:{past}", "{amount:numeral}", "{item:noun_pl}"],
      "order": "fixed",
      "optional": [{"adposition": "adp/into", "binds": "role/destination"}],
      "bind": {"agent": "role/agent", "amount": "role/amount", "item": "role/item", "destination": "role/destination"},
      "emits": {"triples": [[["$item"], "count_add", "$amount"]], "modality": "actual"}
    },
    {
      "id": "rule/en-transfer-ditransitive",
      "for_scenario": "sc/transfer-role",
      "reads": ["{giver:np}", "give:{past}", "{amount:numeral}", "{item:noun_pl}", "to", "{taker:np}"],
      "order": "fixed",
      "bind": {"giver": "role/giver", "taker": "role/taker", "amount": "role/amount", "item": "role/item"},
      "emits": {"triples": [[["$giver", "$item"], "count_remove", "$amount"], [["$taker", "$item"], "count_add", "$amount"]], "modality": "actual"},
      "_ko_link": "한국어 '민수가 소라에게 2개를 줬다' 와 같은 의미 구조. open_roles {giver: 은, taker: 에게} 가 영어에서는 {giver: 주어 위치, taker: to-구} 가 된다.",
      "exceptions": ["역할 반전('Sora gave 2 marbles to Minsu')은 다른 사건이다. 같은 사건의 다른 표현이 아니다."]
    },
    {
      "id": "rule/en-transfer-double-object",
      "for_scenario": "sc/transfer-role",
      "reads": ["{giver:np}", "give:{past}", "{taker:np}", "{amount:numeral}", "{item:noun_pl}"],
      "order": "fixed",
      "bind": {"giver": "role/giver", "taker": "role/taker", "amount": "role/amount", "item": "role/item"},
      "emits": {"same_as": "rule/en-transfer-ditransitive"},
      "conditions": ["taker 자리가 사람이고 item 자리가 물건일 것. 둘 다 물건이면 이 규칙을 쓰지 않고 보류한다."],
      "_": "'Minsu gave Sora 2 marbles.' 전치사 없이 위치만으로 taker 를 짚는다. 같은 뜻을 두 어순이 내는 것이 새 문법 조합 시험의 후보다."
    },
    {
      "id": "rule/en-transfer-passive",
      "for_scenario": "sc/transfer-role",
      "reads": ["{taker:np}", "be:{past}", "given", "{amount:numeral}", "{item:noun_pl}"],
      "order": "fixed",
      "optional": [{"adposition": "adp/by", "binds": "role/giver"}],
      "bind": {"taker": "role/taker", "giver": "role/giver", "amount": "role/amount", "item": "role/item"},
      "emits": {"same_as": "rule/en-transfer-ditransitive"},
      "_critical": "문법 주어(taker)와 실제 행위자(giver)가 다르다. 주어를 행위자로 배정하는 구현은 여기서 역할 반전 오답을 낸다. by-구가 없으면 giver 는 미상이며 추측하지 않고 보류한다."
    },
    {
      "id": "rule/en-move-location",
      "for_scenario": "sc/location-move",
      "reads": ["{agent:np}", "move|put:{past}", "{item:np}", "{destination_phrase}"],
      "order": "fixed",
      "optional": [{"adposition": "adp/from", "binds": "role/source"}, {"adposition": "adp/out_of", "binds": "role/source"}],
      "bind": {"item": "role/item", "source": "role/source", "destination": "role/destination", "agent": "role/agent"},
      "conditions": ["destination 이 있을 것. source 만 있으면 이동이 아니라 꺼냄이다."],
      "emits": {"triples": [[["$item"], "location", "$destination"]], "prior": [[["$item"], "location", "$source"]], "modality": "actual"},
      "exceptions": [
        "'I will move the book to the box' 는 planned 라 실제 위치를 바꾸지 않는다.",
        "'in' 이 destination 인지 location 인지 모호하면 후보 둘을 내고 보류한다."
      ]
    },
    {
      "id": "rule/en-location-question",
      "for_scenario": "sc/location-move",
      "reads": ["where", "be:{tense}", "{target:np}"],
      "order": "fixed",
      "optional": [{"adverb": ["now", "before", "earlier"], "sets": "time_scope"}],
      "bind": {"target": "role/target"},
      "emits": {"query": [["$target"], "location", "?value"]},
      "_": "now 와 before 가 현재/이전 위치를 가른다. 표지가 없으면 현재로 읽되 그 선택을 근거에 남긴다."
    },
    {
      "id": "rule/en-comparative-relation",
      "for_scenario": "sc/relation-chain",
      "reads": ["{a:np}", "be:{tense}", "{adj:comparative}", "than", "{b:np}"],
      "order": "fixed",
      "bind": {"a": "role/topic", "b": "role/target"},
      "emits": {"triples": [["$a", "$adj_predicate", "$b"]], "modality": "actual"},
      "predicate_map": {"taller": "taller"},
      "_predicate_map": "taller 는 axioms/core.json 의 strict-height-transitivity 가 실제로 쓰는 술어다(확인함). smaller/bigger/older 는 그 이름의 공리가 axioms 에 없어 predicate_map 에 넣지 않았다 — 03 문서에 '보류' 로 기록했다.",
      "exceptions": ["비교급 연쇄의 추이성은 공리가 정한다. 이 문법 규칙은 삼중항만 만들고 결론을 내지 않는다."]
    },
    {
      "id": "rule/en-isa-classification",
      "for_scenario": "sc/relation-chain",
      "reads": ["{a:np}", "be:{tense}", "a|an", "{b:noun}"],
      "order": "fixed",
      "emits": {"triples": [["$a", "isa", "$b"]]},
      "_": "axioms 의 class-inheritance 규칙(isa + subclass)에 그대로 들어간다."
    },
    {
      "id": "rule/en-conditional-clause",
      "for_scenario": "sc/negation-condition",
      "reads": ["if", "{condition_clause}", "{consequent_clause}"],
      "order": "either_clause_first",
      "emits": {"scope": "conditional", "test": "$condition_clause", "guarded": "$consequent_clause"},
      "conditions": ["consequent 는 condition 이 참으로 확인될 때만 실행된다."],
      "exceptions": [
        "condition 을 이 대화에서 재지 못하면 실행하지도 거짓으로 접지도 않는다. unverified 로 남긴다.",
        "'X, if Y' 어순도 같은 구조다. 절의 순서가 의미를 바꾸지 않는다."
      ]
    },
    {
      "id": "rule/en-definition",
      "for_scenario": "sc/action-learning",
      "reads": ["to", "{verb:base}", "is", "to", "{body_clause}"],
      "alt_reads": [["{verb:gerund}", "means", "{body_clause}"], ["{verb:base}", "means", "to", "{body_clause}"]],
      "order": "fixed",
      "emits": {"definition": {"action": "$verb", "program_from": "$body_clause"}},
      "binds_open_roles_from": "body_clause 안의 자리말",
      "_ko_link": "한국어 '나누다는 상대에게 구슬의 절반을 주는 것이다' 와 같은 자리. 영어는 to-부정사 또는 동명사가 표제 자리를 맡는다.",
      "exceptions": ["뜻풀이 안의 자리말은 그 사건이 채운다. 자리말을 고유명사로 읽으면 정의가 한 사람에게 고정된다."]
    },
    {
      "id": "rule/en-placeholder-nouns",
      "for_scenario": "sc/action-learning",
      "placeholders": [
        {"surface": ["the other person", "the other", "someone else"], "role_hint": "role/taker"},
        {"surface": ["someone", "a person", "somebody"], "role_hint": "role/agent"},
        {"surface": ["something", "a thing", "an item", "an object"], "role_hint": "role/item"},
        {"surface": ["I", "me", "myself"], "role_hint": "role/agent", "_": "한국어 '임자자리말'(나/내/자신/자기) 의 대응. 영어는 격에 따라 I/me 로 갈린다."},
        {"surface": ["somewhere", "a place"], "role_hint": "role/destination"}
      ],
      "_": "한국어 팩 '자리말' 의 대응. 영어 자리말은 다어절이 많아서(the other person) 한 낱말 단위로 찾으면 못 잡는다."
    },
    {
      "id": "rule/en-ellipsis-pronoun-subject",
      "for_scenario": "sc/deixis",
      "reads": ["{pronoun}", "{predicate}"],
      "order": "fixed",
      "conditions": ["pronoun 이 직전 초점과 유형·수가 맞을 것", "후보가 정확히 하나일 것"],
      "emits": {"resolve": "$pronoun -> 직전 초점 사건/대상 ID"},
      "exceptions": ["후보가 둘 이상이면 해소하지 않고 되물음을 낸다.", "언어가 바뀌어도 후보는 같은 사건 ID 집합에서 찾는다."]
    },
    {
      "id": "rule/en-why-question",
      "for_scenario": "sc/premise-and-reason",
      "reads": ["why"],
      "alt_reads": [["why", "is", "that"], ["how", "do", "you", "know"]],
      "order": "fixed",
      "emits": {"query": "explain(last_conclusion)"},
      "_": "설명은 그 사건·개념 구조·전제·실제 적용된 규칙을 가리켜야 한다. 폐기된 근거를 현재 이유로 제시하지 않는다."
    },
    {
      "id": "rule/en-correction",
      "for_scenario": "sc/cross-language-correction",
      "reads": ["Correction:", "{old_text}", "=>", "{new_text}"],
      "alt_reads": [["I", "was", "wrong:", "{old_text}", "=>", "{new_text}"]],
