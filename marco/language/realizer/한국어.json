  "current": {"word": "지금"},
  "value": {"word": "값"},
  "again": {"word": "다시"},
  "say": {"verb": "말하", "kind": "regular"},
  "earlier": {"word": "앞선"},
  "find": {"verb": "찾", "kind": "regular"},
  "held_tag": {"word": "[보류]"},
  "bound": {"word": "한도"},
  "reckoning": {"word": "셈"},
  "thing": {"word": "것"}
 },
 "lexicon_forms": {},
