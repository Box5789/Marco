{
 "_about": "Korean realizer declarations: orthography, case particles, lexicon, endings, expression candidates per frame, and the reading rules the semantic check applies. Particle mates, the inflection grammar, negation, numerals, senses and romanization are reused from styles/한국어.json through its parser; nothing here repeats them.",
 "language": "한국어",
 "negation_marker_key": "부정표지",
 "pack": "styles/한국어.json",
 "pack_keys": {
  "_about": "Names the pack itself uses for these fields.",
  "exception_codas": "받침예외",
  "exception_form": "쓸것",
  "negation_connective": "연결",
  "negation_stem": "어간",
  "negation_kind": "갈래"
 },
 "orthography": {
  "word_separator": " ",
  "sentence_separator": " ",
  "list_separator": ", ",
  "quotes": {"double": ["\"", "\""], "single": ["'", "'"]},
  "cite": [" (", ")"],
  "cite_separator": ", ",
  "symbols": {"arrow": " → ", "slash": "/", "colon": ":", "semicolon": "; ", "middle_dot": "·", "comma": ","},
  "punctuation": {"declarative": ".", "question": "?", "request": "."},
  "initial_capital": false,
  "digit_codas": {"0": "ㅇ", "1": "ㄹ", "2": "", "3": "ㅁ", "4": "", "5": "", "6": "ㄱ", "7": "ㄹ", "8": "ㄹ", "9": ""},
  "latin_codas": "romanization",
  "compound": {
   "_about": "The engine's compound subject (owner words, then item words) is said by juxtaposition.",
   "join": "juxtapose"
  }
 },
 "register": {
  "default": "formal",
  "from_endings": {
   "informal": "casual",
   "polite": "polite",
   "formal_declarative": "formal",
   "plain": "plain",
   "indicative": "plain"
  }
 },
 "sentence_endings": {
  "declarative": {
   "formal": "formal_declarative",
   "polite": "polite",
   "casual": "informal",
   "plain": "indicative",
   "reading": "plain"
  },
  "question": {
   "formal": "question_ga_polite",
   "polite": "question_ga_polite",
   "casual": "informal",
   "plain": "question_ga",
   "reading": "question_ga"
  },
  "request": {
   "formal": "request_polite",
   "polite": "request_polite",
   "casual": "informal",
   "plain": "request_polite",
   "reading": "request_polite"
  }
 },
 "grammar": {
  "kinds": ["copula"],
  "endings": {
   "formal_declarative": [
    {"steps": [{"op": "coda_suffix", "coda": "ㅂ", "open": "니다", "closed": "습니다", "drop_codas": ["ㄹ"]}]}
   ],
   "connective_ji": [{"steps": [{"op": "append", "text": "지"}]}],
   "whether": [{"steps": [{"op": "append", "text": "는지"}]}],
   "nominal": [{"steps": [{"op": "append", "text": "기"}]}]
  },
  "negation": {"not": {"from_pack": true}, "cannot": {"connective": "지", "aux": "못하", "kind": "regular"}},
  "copula": {
   "stem": "이",
   "kind": "copula",
   "question_kind": "descriptive",
   "bind": true,
   "after_open": {"informal": "야", "plain": "다"},
   "after_closed": {"informal": "이야"}
  },
  "noun_number": null,
  "strategies": {"verbs": "endings", "case_marking": "particles"}
 },
 "cases": {
  "topic": {"mate": "은"},
  "subject": {"mate": "이"},
  "object": {"mate": "을"},
  "goal": {"mate": "으로"},
  "with": {"mate": "과"},
  "recipient": {"form": "에게"},
  "locative": {"form": "에"},
  "source": {"form": "에서"},
  "genitive": {"form": "의"}
 },
 "counters": {"count": {"form": "개"}},
 "numbers": {
  "_about": "How a number is said. Digits by default; numeral words (native Korean before a counter) when an expression asks for them.",
